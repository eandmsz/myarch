# Arch Pulse - static logo, pulsing neon glow.
# Time-based (self-calibrating clock), ping-pong, sine ease-in-out. Same curve forwards and backwards.
# Speed: change `period`. Glow size / colors / thickness are baked into the PNGs.

pi         = 3.14159265358979;
period     = 3.3333;    # seconds per full breath (there and back)
inner_min  = 0.3;
outer_min  = 0.05;
glow_max   = 1.0;
refresh_hz = 60;          # starting guess only; calibrated from Plymouth's boot clock after ~1 s

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo_img  = Image("logo.png");
inner_img = Image("glow_inner.png");
outer_img = Image("glow_outer.png");
logo_w = logo_img.GetWidth();
logo_h = logo_img.GetHeight();
x = Math.Int(Window.GetX() + (Window.GetWidth()  - logo_w) / 2);
y = Math.Int(Window.GetY() + (Window.GetHeight() - logo_h) / 2);

outer_sprite = Sprite(outer_img);
inner_sprite = Sprite(inner_img);
logo_sprite  = Sprite(logo_img);
outer_sprite.SetPosition(x, y, 10);
inner_sprite.SetPosition(x, y, 11);
logo_sprite.SetPosition(x, y, 20);

# --- clock: advances est_dt per refresh; est_dt is corrected from real boot time ---
est_dt    = 1 / refresh_hz;
clock     = 0;
tick      = 0;
sync_time = -1;
sync_tick = 0;
last_in   = -1;
last_out  = -1;

# ping-pong fold + sine ease: 0..1, zero speed at both ends, identical in both directions
fun level(t) {
    n = Math.Int(t / global.period);
    u = (t - n * global.period) / (global.period / 2);   # 0..2
    if (u > 1) { u = 2 - u; }
    return 0.5 - 0.5 * Math.Cos(global.pi * u);
}

fun refresh() {
    global.tick  = global.tick + 1;
    global.clock = global.clock + global.est_dt;
    a_in  = global.inner_min + (global.glow_max - global.inner_min) * level(global.clock);
    a_out = global.outer_min + (global.glow_max - global.outer_min) * level(global.clock);
    # skip redundant updates (< ~1/255): invisible, and saves work at the slow ends of the sine
    if (Math.Abs(a_in - global.last_in) >= 0.004) {
        global.inner_sprite.SetOpacity(a_in);
        global.last_in = a_in;
    }
    if (Math.Abs(a_out - global.last_out) >= 0.004) {
        global.outer_sprite.SetOpacity(a_out);
        global.last_out = a_out;
    }
}

# real elapsed seconds from plymouthd -> measure the true refresh interval, smoothly adapt est_dt
fun on_progress(t_now, progress) {
    if (global.sync_time < 0) {
        global.sync_time = t_now;
        global.sync_tick = global.tick;
    } else {
        d_real  = t_now - global.sync_time;
        d_ticks = global.tick - global.sync_tick;
        if (d_real >= 0.25 && d_ticks >= 5) {
            m = d_real / d_ticks;
            if (m > 0.005 && m < 0.1) {
                global.est_dt = 0.8 * global.est_dt + 0.2 * m;
            }
            global.sync_time = t_now;
            global.sync_tick = global.tick;
        }
    }
}

# --- disk-password / question prompt (needed on encrypted systems) ---
prompt_sprite = Sprite();
prompt_sprite.SetOpacity(0);

fun show_prompt(text) {
    img = Image.Text(text, 1, 1, 1);
    global.prompt_sprite.SetImage(img);
    global.prompt_sprite.SetX(Math.Int(global.x + (global.logo_w - img.GetWidth()) / 2));
    global.prompt_sprite.SetY(global.y + global.logo_h + 10);
    global.prompt_sprite.SetZ(30);
    global.prompt_sprite.SetOpacity(1);
}
fun display_password_callback(prompt, bullets) {
    s = prompt + " ";
    for (i = 0; i < bullets; i++) { s = s + "*"; }
    show_prompt(s);
}
fun display_question_callback(prompt, entry) { show_prompt(prompt + " " + entry); }
fun display_normal_callback() { global.prompt_sprite.SetOpacity(0); }

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetBootProgressFunction(on_progress);
refresh();
Plymouth.SetRefreshFunction(refresh);
